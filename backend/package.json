    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.22.0",
    "rate-limit-redis": "^6.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^12.0.4",
    "eslint": "^9.5.0",
    "globals": "^16.5.0",
